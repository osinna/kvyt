LOG_LEVEL=INFO
BUG_SCENARIO=

POSTGRES_ADMIN_USER=kvyt_admin
POSTGRES_ADMIN_PASSWORD=kvyt_admin_pass

JWT_SECRET=change-me-before-any-real-deploy

# Client secret of the OAuth2 client partner-service (Client Credentials flow)
PARTNER_SERVICE_SECRET=partner-secret-local-only

# Midnight UTC of the current day when empty. ISO date/time, e.g. 2026-10-01
SEED_EPOCH=

# Delay before notify creates a notification, in ms: random, spread log-uniformly
# between the two bounds, so most notifications appear within a second and a few
# take up to the upper bound. Equal values give a fixed delay.
NOTIFY_DELAY_MIN_MS=1
NOTIFY_DELAY_MAX_MS=2500
